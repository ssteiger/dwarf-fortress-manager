# Public URLs
SUPABASE_API_URL="http://127.0.0.1:54421"
SUPABASE_GRAPHQL_URL="http://127.0.0.1:54421/graphql/v1"
SUPABASE_STORAGE_URL="http://127.0.0.1:54421/storage/v1/s3"
SUPABASE_STUDIO_URL="http://127.0.0.1:54423"
INBUCKET_URL="http://127.0.0.1:54424"
SUPABASE_ANON_KEY=""

# Private configuration
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_S3_ACCESS_KEY=""
SUPABASE_S3_SECRET_KEY=""
SUPABASE_S3_REGION="local"

# Dwarf Fortress worker
# Folder containing "Dwarf Fortress.exe" and dfhack-config/. Defaults to the
# Steam copy inside the CrossOver "Steam" bottle.
# DF_GAME_DIR="/Users/you/Library/Application Support/CrossOver/Bottles/Steam/drive_c/Program Files (x86)/Steam/steamapps/common/Dwarf Fortress"
# Folder scanned for *-legends.xml and *-legends_plus.xml exports (default: DF_GAME_DIR).
# DF_LEGENDS_DIR=""
DFHACK_HOST="127.0.0.1"
DFHACK_PORT="5000"
# Units, items, buildings, jobs, and announcements (milliseconds).
DF_POLL_MS="30000"
# The map pauses the game for a few seconds, so it runs less often.
DF_MAP_POLL_MS="300000"
# Set to 0 to skip importing legends exports.
DF_IMPORT_LEGENDS="1"
