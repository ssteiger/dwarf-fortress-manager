# Public URLs
SUPABASE_API_URL="http://127.0.0.1:54421"
SUPABASE_GRAPHQL_URL="http://127.0.0.1:54421/graphql/v1"
SUPABASE_STORAGE_URL="http://127.0.0.1:54421/storage/v1/s3"
SUPABASE_STUDIO_URL="http://127.0.0.1:54423"
INBUCKET_URL="http://127.0.0.1:54424"
SUPABASE_ANON_KEY=""

# Private configuration
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
# Populate from `supabase status` output after running `bun run dev:db`.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_S3_ACCESS_KEY=""
SUPABASE_S3_SECRET_KEY=""
SUPABASE_S3_REGION="local"

# Optional language model for the legends narrator, the nickname writer, a
# dwarf's voice and the assistant in the header. Leave empty and the pages keep
# to their deterministic prose and fact-based nickname ideas. Provider is
# "openai", "anthropic" or "cursor" (a Cursor API key from cursor.com/dashboard
# -> Integrations; CURSOR_API_KEY works too). The model defaults to gpt-4o-mini,
# claude-3-5-haiku-latest or composer-2.5 when unset.
LEGENDS_NARRATOR_PROVIDER=""
LEGENDS_NARRATOR_API_KEY=""
LEGENDS_NARRATOR_MODEL=""
# Optional API root, for an OpenAI-compatible local server such as Ollama
# (http://127.0.0.1:11434/v1) or LM Studio.
LEGENDS_NARRATOR_BASE_URL=""
